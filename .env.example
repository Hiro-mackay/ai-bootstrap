# Shared, port-independent config. Copied to .env by `task worktree:init`.
#
# Host ports and the values derived from them (POSTGRES_PORT, APP_PORT, BUN_PORT,
# DATABASE_URL, ALLOWED_ORIGINS, BUN_PUBLIC_API_BASE_URL, COMPOSE_PROJECT_NAME)
# are NOT set here -- they are allocated per worktree into .env.worktree by
# `task worktree:init` so that several worktrees can run `task dev` in parallel
# without port clashes. See .claude/rules/multi-worktree-dev.md.

# Backend (Go)
LOG_LEVEL=info

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_dev

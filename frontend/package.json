{
  "name": "your-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "bun ./src/index.html",
    "build": "bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --env=BUN_PUBLIC_*",
    "preview": "bunx serve dist -l 4173",
    "test": "bun run vitest run",
    "test:watch": "bun run vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.10",
    "@tanstack/react-query": "^5.65.0",
    "@tanstack/react-router": "^1.120.0",
    "@bufbuild/protobuf": "^2.0.0",
    "@connectrpc/connect": "^2.0.0",
    "@connectrpc/connect-query": "^2.0.0",
    "@connectrpc/connect-web": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^25.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/bun": "latest",
    "jsdom": "^26.0.0",
    "lefthook": "^1.12.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}

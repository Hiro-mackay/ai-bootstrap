{
  "name": "your-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "tsr generate && bun ./src/index.html",
    "build": "tsr generate && bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --splitting --define 'process.env.NODE_ENV=\"production\"' --env='BUN_PUBLIC_*'",
    "routes:generate": "tsr generate",
    "routes:watch": "tsr watch",
    "preview": "bunx serve dist -l 4173",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "biome check .",
    "format": "biome check --write .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.0.0",
    "@connectrpc/connect": "^2.0.0",
    "@connectrpc/connect-query": "^2.0.0",
    "@connectrpc/connect-web": "^2.0.0",
    "@t3-oss/env-core": "^0.13.10",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.166.2",
    "clsx": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "zod": "^4.0.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@happy-dom/global-registrator": "^20.8.3",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/router-cli": "^1.166.2",
    "@tanstack/router-devtools": "^1.166.2",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.2.0",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bun-plugin-tailwind": "^0.1.2",
    "typescript": "^7.0.2"
  }
}
